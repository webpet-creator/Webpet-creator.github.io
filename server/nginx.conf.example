# /etc/nginx/sites-available/portfolio — remplacer example.com par le vrai domaine.
# Le HTTPS est ajouté ensuite par : certbot --nginx -d example.com
server {
    listen 80;
    server_name example.com;

    root /var/www/portfolio;   # contenu du dossier dist
    index index.html;

    # Compression : divise par trois le poids du JavaScript et du CSS.
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/xml;
    gzip_min_length 1024;

    # Pages pré-rendues : /fr -> /fr/index.html, etc.
    location / {
        try_files $uri $uri/index.html =404;
    }
    error_page 404 /404.html;

    # Fichiers au nom haché : cache long.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Formulaire de contact -> service Python local.
    location = /api/contact {
        limit_except POST { deny all; }
        client_max_body_size 16k;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
